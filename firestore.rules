rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function workspacePath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId);
    }

    function locationPath(workspaceId, locationId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/locations/$(locationId);
    }

    function isWorkspaceManager(workspaceId) {
      return signedIn()
        && exists(workspacePath(workspaceId))
        && get(workspacePath(workspaceId)).data.managerUid == request.auth.uid;
    }

    function isWorkspaceManagerAfter(workspaceId) {
      return signedIn()
        && existsAfter(workspacePath(workspaceId))
        && getAfter(workspacePath(workspaceId)).data.managerUid == request.auth.uid;
    }

    function isLocationCoordinate(value) {
      return value is map
        && value.keys().hasOnly(['lat', 'lng'])
        && value.lat is number
        && value.lng is number
        && value.lat >= -90
        && value.lat <= 90
        && value.lng >= -180
        && value.lng <= 180;
    }

    function isLocationBase(workspaceId, data) {
      return data.workspaceId == workspaceId
        && data.name is string
        && data.name.size() > 0
        && data.nameKey is string
        && data.nameKey.size() > 0
        && data.roadAddress is string
        && data.roadAddress.size() > 0
        && data.addressText is string
        && data.addressText.size() > 0
        && data.radiusMeters is int
        && data.radiusMeters > 0
        && data.radiusMeters <= 9999
        && isLocationCoordinate(data.coordinate)
        && data.geocodingStatus == 'resolved';
    }

    function isLocationCreate(workspaceId) {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'addressText',
          'coordinate',
          'createdAt',
          'createdBy',
          'dutyCount',
          'geocodingStatus',
          'name',
          'nameKey',
          'radiusMeters',
          'roadAddress',
          'status',
          'updatedAt',
          'workspaceId'
        ])
        && isLocationBase(workspaceId, data)
        && data.status == 'active'
        && data.dutyCount == 0
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isLocationEdit(workspaceId) {
      let data = request.resource.data;
      let changedKeys = data.diff(resource.data).affectedKeys();

      return resource.data.status != 'deleted'
        && changedKeys.hasOnly([
          'addressText',
          'coordinate',
          'geocodingStatus',
          'name',
          'nameKey',
          'radiusMeters',
          'roadAddress',
          'updatedAt'
        ])
        && isLocationBase(workspaceId, data)
        && data.status == resource.data.status
        && data.dutyCount == resource.data.dutyCount
        && data.createdAt == resource.data.createdAt
        && data.createdBy == resource.data.createdBy
        && data.updatedAt == request.time;
    }

    function isLocationSoftDelete() {
      let data = request.resource.data;
      let changedKeys = data.diff(resource.data).affectedKeys();

      return resource.data.status != 'deleted'
        && resource.data.dutyCount == 0
        && changedKeys.hasOnly(['deletedAt', 'status', 'updatedAt'])
        && data.status == 'deleted'
        && data.deletedAt == request.time
        && data.updatedAt == request.time;
    }

    function isLocationDutyCountIncrement() {
      let data = request.resource.data;
      let changedKeys = data.diff(resource.data).affectedKeys();

      return resource.data.status == 'active'
        && changedKeys.hasOnly(['dutyCount', 'updatedAt'])
        && data.dutyCount == resource.data.dutyCount + 1
        && data.updatedAt == request.time;
    }

    function isDutyDateValue(value) {
      return value == null ||
        (
          value is string &&
          value.matches('^\\d{4}-\\d{2}-\\d{2}$')
        );
    }

    function isDutyTimeValue(value) {
      return value is string
        && value.matches('^([01]\\d|2[0-3]):[0-5]\\d$');
    }

    function isDutyCreate(workspaceId) {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'assignedWorkerCount',
          'createdAt',
          'createdBy',
          'endTime',
          'locationId',
          'locationName',
          'manualStatus',
          'name',
          'nameKey',
          'operationEndDate',
          'operationStartDate',
          'startTime',
          'tags',
          'updatedAt',
          'weekday',
          'workspaceId'
        ])
        && data.workspaceId == workspaceId
        && data.name is string
        && data.name.size() > 0
        && data.nameKey is string
        && data.nameKey.size() > 0
        && data.tags is list
        && data.tags.size() <= 4
        && data.locationId is string
        && data.locationId.size() > 0
        && existsAfter(locationPath(workspaceId, data.locationId))
        && getAfter(locationPath(workspaceId, data.locationId)).data.status == 'active'
        && data.locationName is string
        && data.locationName.size() > 0
        && data.weekday in ['월', '화', '수', '목', '금', '토', '일']
        && isDutyTimeValue(data.startTime)
        && isDutyTimeValue(data.endTime)
        && data.startTime < data.endTime
        && isDutyDateValue(data.operationStartDate)
        && isDutyDateValue(data.operationEndDate)
        && (
          (data.operationStartDate == null && data.operationEndDate == null) ||
          (
            data.operationStartDate is string &&
            data.operationEndDate is string &&
            data.operationStartDate <= data.operationEndDate
          )
        )
        && data.assignedWorkerCount == 0
        && data.manualStatus == 'active'
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get, create, update: if isSelf(userId);
      allow list, delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow get, list: if isWorkspaceManager(workspaceId);
      allow create: if signedIn()
        && request.resource.data.managerUid == request.auth.uid;
      allow update: if isWorkspaceManager(workspaceId)
        && request.resource.data.managerUid == resource.data.managerUid;
      allow delete: if false;

      match /locations/{locationId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow create: if isWorkspaceManagerAfter(workspaceId)
          && isLocationCreate(workspaceId);
        allow update: if isWorkspaceManagerAfter(workspaceId)
          && (
            isLocationEdit(workspaceId) ||
            isLocationDutyCountIncrement() ||
            isLocationSoftDelete()
          );
        allow delete: if false;
      }

      match /duties/{dutyId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow create: if isWorkspaceManagerAfter(workspaceId)
          && isDutyCreate(workspaceId);
        allow update: if false;
        allow delete: if false;
      }
    }

    match /workspaceCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.active == true
        && request.resource.data.workspaceId is string
        && isWorkspaceManagerAfter(request.resource.data.workspaceId);
      allow update, delete: if false;
    }
  }
}
