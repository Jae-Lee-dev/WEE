rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function workspacePath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId);
    }

    function locationPath(workspaceId, locationId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/locations/$(locationId);
    }

    function isWorkspaceManager(workspaceId) {
      return signedIn()
        && exists(workspacePath(workspaceId))
        && get(workspacePath(workspaceId)).data.managerUid == request.auth.uid;
    }

    function isWorkspaceManagerAfter(workspaceId) {
      return signedIn()
        && existsAfter(workspacePath(workspaceId))
        && getAfter(workspacePath(workspaceId)).data.managerUid == request.auth.uid;
    }

    function isLocationCoordinate(value) {
      return value is map
        && value.keys().hasOnly(['lat', 'lng'])
        && value.lat is number
        && value.lng is number
        && value.lat >= -90
        && value.lat <= 90
        && value.lng >= -180
        && value.lng <= 180;
    }

    function isLocationBase(workspaceId, data) {
      return data.workspaceId == workspaceId
        && data.name is string
        && data.name.size() > 0
        && data.nameKey is string
        && data.nameKey.size() > 0
        && data.roadAddress is string
        && data.roadAddress.size() > 0
        && data.addressText is string
        && data.addressText.size() > 0
        && data.radiusMeters is int
        && data.radiusMeters > 0
        && data.radiusMeters <= 9999
        && isLocationCoordinate(data.coordinate)
        && data.geocodingStatus == 'resolved';
    }

    function isLocationCreate(workspaceId) {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'addressText',
          'coordinate',
          'createdAt',
          'createdBy',
          'dutyCount',
          'geocodingStatus',
          'name',
          'nameKey',
          'radiusMeters',
          'roadAddress',
          'status',
          'updatedAt',
          'workspaceId'
        ])
        && isLocationBase(workspaceId, data)
        && data.status == 'active'
        && data.dutyCount == 0
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isLocationEdit(workspaceId) {
      let data = request.resource.data;
      let changedKeys = data.diff(resource.data).affectedKeys();

      return resource.data.status != 'deleted'
        && changedKeys.hasOnly([
          'addressText',
          'coordinate',
          'geocodingStatus',
          'name',
          'nameKey',
          'radiusMeters',
          'roadAddress',
          'updatedAt'
        ])
        && isLocationBase(workspaceId, data)
        && data.status == resource.data.status
        && data.dutyCount == resource.data.dutyCount
        && data.createdAt == resource.data.createdAt
        && data.createdBy == resource.data.createdBy
        && data.updatedAt == request.time;
    }

    function isLocationSoftDelete() {
      let data = request.resource.data;
      let changedKeys = data.diff(resource.data).affectedKeys();

      return resource.data.status != 'deleted'
        && resource.data.dutyCount == 0
        && changedKeys.hasOnly(['deletedAt', 'status', 'updatedAt'])
        && data.status == 'deleted'
        && data.deletedAt == request.time
        && data.updatedAt == request.time;
    }

    function isLocationDutyCountIncrement() {
      let data = request.resource.data;
      let changedKeys = data.diff(resource.data).affectedKeys();

      return resource.data.status == 'active'
        && changedKeys.hasOnly(['dutyCount', 'updatedAt'])
        && data.dutyCount == resource.data.dutyCount + 1
        && data.updatedAt == request.time;
    }

    function isDutyDateValue(value) {
      return value == null ||
        (
          value is string &&
          value.matches('^\\d{4}-\\d{2}-\\d{2}$')
        );
    }

    function isDutyTimeValue(value) {
      return value is string
        && value.matches('^([01]\\d|2[0-3]):[0-5]\\d$');
    }

    function isDutyCreate(workspaceId) {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'assignedWorkerCount',
          'createdAt',
          'createdBy',
          'endTime',
          'locationId',
          'locationName',
          'manualStatus',
          'name',
          'nameKey',
          'operationEndDate',
          'operationStartDate',
          'startTime',
          'tags',
          'updatedAt',
          'weekday',
          'workspaceId'
        ])
        && data.workspaceId == workspaceId
        && data.name is string
        && data.name.size() > 0
        && data.nameKey is string
        && data.nameKey.size() > 0
        && data.tags is list
        && data.tags.size() <= 4
        && data.locationId is string
        && data.locationId.size() > 0
        && existsAfter(locationPath(workspaceId, data.locationId))
        && getAfter(locationPath(workspaceId, data.locationId)).data.status == 'active'
        && data.locationName is string
        && data.locationName.size() > 0
        && data.weekday in ['월', '화', '수', '목', '금', '토', '일']
        && isDutyTimeValue(data.startTime)
        && isDutyTimeValue(data.endTime)
        && data.startTime < data.endTime
        && isDutyDateValue(data.operationStartDate)
        && isDutyDateValue(data.operationEndDate)
        && (
          (data.operationStartDate == null && data.operationEndDate == null) ||
          (
            data.operationStartDate is string &&
            data.operationEndDate is string &&
            data.operationStartDate <= data.operationEndDate
          )
        )
        && data.assignedWorkerCount == 0
        && data.manualStatus == 'active'
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isNotificationEventMap(value) {
      return value is map
        && value.keys().hasOnly([
          'affiliation-application-received',
          'affiliation-application-accepted',
          'overtime-application',
          'correction-received'
        ])
        && value.keys().hasAll([
          'affiliation-application-received',
          'affiliation-application-accepted',
          'overtime-application',
          'correction-received'
        ])
        && value['affiliation-application-received'] is bool
        && value['affiliation-application-accepted'] is bool
        && value['overtime-application'] is bool
        && value['correction-received'] is bool;
    }

    function isNotificationSettingsBase(workspaceId) {
      let data = request.resource.data;

      return data.workspaceId == workspaceId
        && data.kakaoAlimtalkEnabled is bool
        && data.managerWebEnabled is bool
        && isNotificationEventMap(data.kakaoAlimtalk)
        && isNotificationEventMap(data.managerWeb)
        && data.updatedAt == request.time;
    }

    function isNotificationSettingsCreate(workspaceId) {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'kakaoAlimtalk',
          'kakaoAlimtalkEnabled',
          'managerWeb',
          'managerWebEnabled',
          'updatedAt',
          'workerFcmEnabled',
          'workerPush',
          'workspaceId'
        ])
        && isNotificationSettingsBase(workspaceId)
        && (
          !data.keys().hasAny(['workerFcmEnabled']) ||
          data.workerFcmEnabled is bool
        )
        && (
          !data.keys().hasAny(['workerPush']) ||
          data.workerPush is bool
        );
    }

    function isNotificationSettingsEdit(workspaceId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();

      return isNotificationSettingsBase(workspaceId)
        && changedKeys.hasOnly([
          'kakaoAlimtalk',
          'kakaoAlimtalkEnabled',
          'managerWeb',
          'managerWebEnabled',
          'updatedAt',
          'workspaceId'
        ]);
    }

    function isTagColor(value) {
      return value in ['green', 'blue', 'orange', 'red', 'grey', 'gray', 'pink'];
    }

    function isWorkspaceTagBase(workspaceId, data) {
      return data.workspaceId == workspaceId
        && data.name is string
        && data.name.size() > 0
        && data.nameKey is string
        && data.nameKey.size() > 0
        && isTagColor(data.color)
        && data.status in ['active', 'inactive', 'deleted']
        && data.usageCount is int
        && data.usageCount >= 0;
    }

    function isWorkspaceTagCreate(workspaceId) {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'color',
          'createdAt',
          'createdBy',
          'name',
          'nameKey',
          'status',
          'updatedAt',
          'usageCount',
          'workspaceId'
        ])
        && isWorkspaceTagBase(workspaceId, data)
        && data.status in ['active', 'inactive']
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isWorkspaceTagEdit(workspaceId) {
      let data = request.resource.data;
      let changedKeys = data.diff(resource.data).affectedKeys();

      return resource.data.status != 'deleted'
        && changedKeys.hasOnly([
          'color',
          'name',
          'nameKey',
          'status',
          'updatedAt',
          'usageCount'
        ])
        && isWorkspaceTagBase(workspaceId, data)
        && data.status in ['active', 'inactive']
        && data.createdAt == resource.data.createdAt
        && data.createdBy == resource.data.createdBy
        && data.updatedAt == request.time;
    }

    function isWorkspaceTagSoftDelete(workspaceId) {
      let data = request.resource.data;
      let changedKeys = data.diff(resource.data).affectedKeys();

      return resource.data.status != 'deleted'
        && changedKeys.hasOnly(['deletedAt', 'status', 'updatedAt', 'usageCount'])
        && isWorkspaceTagBase(workspaceId, data)
        && data.status == 'deleted'
        && data.usageCount == 0
        && data.deletedAt == request.time
        && data.updatedAt == request.time;
    }

    function isWorkerTagAssignmentEdit() {
      let data = request.resource.data;
      let changedKeys = data.diff(resource.data).affectedKeys();

      return resource.data.status != 'deleted'
        && changedKeys.hasOnly(['tagIds', 'updatedAt'])
        && data.tagIds is list
        && data.tagIds.size() <= 20
        && data.updatedAt == request.time;
    }

    function isWorkerDetailEdit() {
      let data = request.resource.data;
      let changedKeys = data.diff(resource.data).affectedKeys();

      return resource.data.status != 'deleted'
        && changedKeys.hasOnly([
          'contact',
          'name',
          'nameKey',
          'status',
          'tagIds',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.nameKey is string
        && data.nameKey.size() > 0
        && data.contact is string
        && data.status in ['active', 'inactive']
        && data.tagIds is list
        && data.tagIds.size() <= 20
        && data.updatedAt == request.time;
    }

    function isWorkerMembershipDecisionEdit() {
      let data = request.resource.data;
      let changedKeys = data.diff(resource.data).affectedKeys();

      return resource.data.status != 'deleted'
        && changedKeys.hasOnly([
          'approvedAt',
          'membershipStatus',
          'rejectionReason',
          'status',
          'tagIds',
          'updatedAt'
        ])
        && data.membershipStatus in ['approved', 'rejected']
        && data.status in ['active', 'inactive']
        && (
          !data.keys().hasAny(['tagIds']) ||
          (
            data.tagIds is list &&
            data.tagIds.size() <= 20
          )
        )
        && (
          !data.keys().hasAny(['rejectionReason']) ||
          data.rejectionReason is string
        )
        && (
          !changedKeys.hasAny(['approvedAt']) ||
          data.approvedAt == request.time
        )
        && data.updatedAt == request.time;
    }

    function isWorkerApprovalCreate(workspaceId, workerId) {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'account',
          'appliedAt',
          'approvedAt',
          'bankbookDownloadUrl',
          'bankbookStatus',
          'contact',
          'createdAt',
          'membershipId',
          'membershipStatus',
          'name',
          'nameKey',
          'status',
          'tagIds',
          'updatedAt',
          'workerId',
          'workerUid',
          'workspaceId'
        ])
        && data.workspaceId == workspaceId
        && data.workerId == workerId
        && data.membershipId is string
        && data.membershipId.size() > 0
        && data.name is string
        && data.name.size() > 0
        && data.nameKey is string
        && data.nameKey.size() > 0
        && data.contact is string
        && data.membershipStatus == 'approved'
        && data.status == 'active'
        && data.tagIds is list
        && data.tagIds.size() <= 20
        && data.createdAt == request.time
        && data.approvedAt == request.time
        && data.updatedAt == request.time
        && (
          !data.keys().hasAny(['workerUid']) ||
          data.workerUid is string
        )
        && (
          !data.keys().hasAny(['bankbookDownloadUrl']) ||
          data.bankbookDownloadUrl is string
        )
        && (
          !data.keys().hasAny(['bankbookStatus']) ||
          data.bankbookStatus is string
        );
    }

    function isPayrollDateValue(value) {
      return value is string
        && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isPayrollTaxBase(data) {
      return data.taxType in ['custom', 'none']
        && (
          (
            data.taxType == 'custom'
            && data.taxRatePercent is number
            && data.taxRatePercent >= 0
            && data.taxRatePercent <= 100
          ) ||
          (
            data.taxType == 'none'
            && data.taxRatePercent == null
          )
        );
    }

    function isPayrollAmountBase(data) {
      return data.payrollType in ['hourly', 'monthly']
        && (
          (
            data.payrollType == 'hourly'
            && data.hourlyRate is int
            && data.hourlyRate > 0
            && data.monthlySalary == null
          ) ||
          (
            data.payrollType == 'monthly'
            && data.monthlySalary is int
            && data.monthlySalary > 0
            && data.hourlyRate == null
          )
        );
    }

    function isPayrollSettingBase(workspaceId, data) {
      return data.workspaceId == workspaceId
        && data.workerId is string
        && data.workerId.size() > 0
        && data.workerName is string
        && data.workerName.size() > 0
        && data.status == 'active'
        && isPayrollDateValue(data.effectiveFrom)
        && isPayrollAmountBase(data)
        && isPayrollTaxBase(data);
    }

    function isPayrollSettingCreate(workspaceId) {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'createdAt',
          'effectiveFrom',
          'hourlyRate',
          'monthlySalary',
          'payrollType',
          'status',
          'taxRatePercent',
          'taxType',
          'updatedAt',
          'workerId',
          'workerName',
          'workspaceId'
        ])
        && isPayrollSettingBase(workspaceId, data)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isPayrollSettingEdit(workspaceId) {
      let data = request.resource.data;
      let changedKeys = data.diff(resource.data).affectedKeys();

      return changedKeys.hasOnly([
          'effectiveFrom',
          'hourlyRate',
          'monthlySalary',
          'payrollType',
          'status',
          'taxRatePercent',
          'taxType',
          'updatedAt',
          'workerName'
        ])
        && isPayrollSettingBase(workspaceId, data)
        && data.createdAt == resource.data.createdAt
        && data.workerId == resource.data.workerId
        && data.workspaceId == resource.data.workspaceId
        && data.updatedAt == request.time;
    }

    function isDutyTagAssignmentEdit() {
      let data = request.resource.data;
      let changedKeys = data.diff(resource.data).affectedKeys();

      return resource.data.manualStatus != 'deleted'
        && changedKeys.hasOnly(['tags', 'updatedAt'])
        && data.tags is list
        && data.tags.size() <= 8
        && data.updatedAt == request.time;
    }

    function isDutyDefinitionEdit(workspaceId) {
      let data = request.resource.data;
      let changedKeys = data.diff(resource.data).affectedKeys();

      return resource.data.manualStatus != 'deleted'
        && changedKeys.hasOnly([
          'endTime',
          'locationId',
          'locationName',
          'name',
          'nameKey',
          'operationEndDate',
          'operationStartDate',
          'startTime',
          'tags',
          'updatedAt',
          'weekday'
        ])
        && data.workspaceId == workspaceId
        && data.name is string
        && data.name.size() > 0
        && data.nameKey is string
        && data.nameKey.size() > 0
        && data.tags is list
        && data.tags.size() <= 8
        && data.locationId is string
        && data.locationId.size() > 0
        && existsAfter(locationPath(workspaceId, data.locationId))
        && getAfter(locationPath(workspaceId, data.locationId)).data.status == 'active'
        && data.locationName is string
        && data.locationName.size() > 0
        && data.weekday in ['월', '화', '수', '목', '금', '토', '일']
        && isDutyTimeValue(data.startTime)
        && isDutyTimeValue(data.endTime)
        && data.startTime < data.endTime
        && isDutyDateValue(data.operationStartDate)
        && isDutyDateValue(data.operationEndDate)
        && (
          (data.operationStartDate == null && data.operationEndDate == null) ||
          (
            data.operationStartDate is string &&
            data.operationEndDate is string &&
            data.operationStartDate <= data.operationEndDate
          )
        )
        && data.assignedWorkerCount == resource.data.assignedWorkerCount
        && data.manualStatus == resource.data.manualStatus
        && data.createdAt == resource.data.createdAt
        && data.createdBy == resource.data.createdBy
        && data.updatedAt == request.time;
    }

    function isWorkspaceScopedManagerWrite(workspaceId) {
      return isWorkspaceManagerAfter(workspaceId)
        && (
          !request.resource.data.keys().hasAny(['workspaceId']) ||
          request.resource.data.workspaceId == workspaceId
        );
    }

    function isWorkRecordManagerAction() {
      let data = request.resource.data;
      let changedKeys = data.diff(resource.data).affectedKeys();

      return resource.data.status != 'paid'
        && changedKeys.hasOnly([
          'deletedAt',
          'effectiveEndAt',
          'effectiveStartAt',
          'hasPendingCorrection',
          'hasPendingOvertime',
          'hasUnresolvedAnomaly',
          'managerOnly',
          'status',
          'updatedAt'
        ])
        && (
          (
            data.status in ['resolved', 'deleted']
            && data.hasUnresolvedAnomaly == false
          ) ||
          (
            changedKeys.hasOnly(['hasPendingCorrection', 'updatedAt'])
            && data.hasPendingCorrection == false
          ) ||
          (
            changedKeys.hasOnly(['hasPendingOvertime', 'updatedAt'])
            && data.hasPendingOvertime is bool
          )
        )
        && data.updatedAt == request.time;
    }

    function isOvertimeWorkManagerCreate(workspaceId) {
      let data = request.resource.data;

      return isWorkspaceScopedManagerWrite(workspaceId)
        && data.keys().hasOnly([
          'amount',
          'approvedAt',
          'attendanceLogId',
          'createdAt',
          'decidedAt',
          'decidedBy',
          'extraEndAt',
          'extraStartAt',
          'managerNote',
          'monthKey',
          'payrollEffect',
          'payrollPayMode',
          'payrollStatus',
          'reason',
          'rejectedReason',
          'status',
          'submittedAt',
          'updatedAt',
          'workRecordId',
          'workerId',
          'workerName',
          'workspaceId'
        ])
        && data.workspaceId == workspaceId
        && data.amount == null
        && data.approvedAt == null
        && data.attendanceLogId is string
        && data.attendanceLogId.size() > 0
        && data.createdAt == request.time
        && data.decidedAt == null
        && data.decidedBy == null
        && data.extraStartAt is timestamp
        && data.extraEndAt is timestamp
        && data.extraEndAt > data.extraStartAt
        && data.managerNote == null
        && data.monthKey is string
        && data.monthKey.size() == 7
        && data.payrollEffect == 'none'
        && data.payrollPayMode == null
        && data.payrollStatus == 'none'
        && data.reason is string
        && data.reason.size() > 0
        && data.rejectedReason == null
        && data.status == 'submitted'
        && data.submittedAt == request.time
        && data.updatedAt == request.time
        && data.workRecordId is string
        && data.workRecordId.size() > 0
        && data.workerId is string
        && data.workerId.size() > 0
        && data.workerName is string
        && data.workerName.size() > 0;
    }

    function isAnomalyFlagManagerResolution() {
      let data = request.resource.data;
      let changedKeys = data.diff(resource.data).affectedKeys();

      return resource.data.status == 'unresolved'
        && changedKeys.hasOnly(['resolvedAt', 'status', 'updatedAt'])
        && data.status == 'resolved'
        && data.resolvedAt == request.time
        && data.updatedAt == request.time;
    }

    function isAnomalyResolutionCreate(workspaceId) {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'anomalyFlagId',
          'createdAt',
          'decidedBy',
          'decision',
          'managerNote',
          'payrollEffect',
          'status',
          'workRecordId',
          'workerId',
          'workspaceId'
        ])
        && data.workspaceId == workspaceId
        && data.createdAt == request.time
        && data.decidedBy == request.auth.uid
        && data.decision in ['mark_normal', 'modify_record', 'delete_record']
        && data.managerNote is string
        && data.payrollEffect in ['applied', 'hold', 'immediate', 'unchanged']
        && data.status == 'completed'
        && data.workRecordId is string
        && data.workRecordId.size() > 0
        && data.workerId is string;
    }

    match /users/{userId} {
      allow get, create, update: if isSelf(userId);
      allow list, delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow get, list: if isWorkspaceManager(workspaceId);
      allow create: if signedIn()
        && request.resource.data.managerUid == request.auth.uid;
      allow update: if isWorkspaceManager(workspaceId)
        && request.resource.data.managerUid == resource.data.managerUid;
      allow delete: if false;

      match /locations/{locationId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow create: if isWorkspaceManagerAfter(workspaceId)
          && isLocationCreate(workspaceId);
        allow update: if isWorkspaceManagerAfter(workspaceId)
          && (
            isLocationEdit(workspaceId) ||
            isLocationDutyCountIncrement() ||
            isLocationSoftDelete()
          );
        allow delete: if false;
      }

      match /duties/{dutyId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow create: if isWorkspaceManagerAfter(workspaceId)
          && isDutyCreate(workspaceId);
        allow update: if isWorkspaceManagerAfter(workspaceId)
          && (
            isDutyTagAssignmentEdit() ||
            isDutyDefinitionEdit(workspaceId)
          );
        allow delete: if false;
      }

      match /dutyTags/{tagId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow create: if isWorkspaceManagerAfter(workspaceId)
          && isWorkspaceTagCreate(workspaceId);
        allow update: if isWorkspaceManagerAfter(workspaceId)
          && (
            isWorkspaceTagEdit(workspaceId) ||
            isWorkspaceTagSoftDelete(workspaceId)
          );
        allow delete: if false;
      }

      match /workerTags/{tagId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow create: if isWorkspaceManagerAfter(workspaceId)
          && isWorkspaceTagCreate(workspaceId);
        allow update: if isWorkspaceManagerAfter(workspaceId)
          && (
            isWorkspaceTagEdit(workspaceId) ||
            isWorkspaceTagSoftDelete(workspaceId)
          );
        allow delete: if false;
      }

      match /workers/{workerId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow update: if isWorkspaceManagerAfter(workspaceId)
          && (
            isWorkerTagAssignmentEdit() ||
            isWorkerDetailEdit() ||
            isWorkerMembershipDecisionEdit()
          );
        allow create: if isWorkspaceManagerAfter(workspaceId)
          && isWorkerApprovalCreate(workspaceId, workerId);
        allow delete: if false;
      }

      match /memberships/{membershipId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow create, update: if isWorkspaceScopedManagerWrite(workspaceId);
        allow delete: if false;
      }

      match /payrollSettings/{settingId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow create: if isWorkspaceManagerAfter(workspaceId)
          && isPayrollSettingCreate(workspaceId);
        allow update: if isWorkspaceManagerAfter(workspaceId)
          && isPayrollSettingEdit(workspaceId);
        allow delete: if false;
      }

      match /scheduleRequests/{requestId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow update: if isWorkspaceScopedManagerWrite(workspaceId);
        allow create, delete: if false;
      }

      match /scheduleVersions/{versionId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow create, update: if isWorkspaceScopedManagerWrite(workspaceId);
        allow delete: if false;
      }

      match /handoverDocuments/{documentId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow create, update: if isWorkspaceScopedManagerWrite(workspaceId);
        allow delete: if false;
      }

      match /subscriptions/{subscriptionId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow create, update: if isWorkspaceScopedManagerWrite(workspaceId);
        allow delete: if false;
      }

      match /bonusItems/{bonusItemId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow create, update: if isWorkspaceScopedManagerWrite(workspaceId);
        allow delete: if false;
      }

      match /correctionRequests/{requestId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow update: if isWorkspaceScopedManagerWrite(workspaceId);
        allow create, delete: if false;
      }

      match /overtimeWorks/{overtimeId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow update: if isWorkspaceScopedManagerWrite(workspaceId);
        allow create: if isOvertimeWorkManagerCreate(workspaceId);
        allow delete: if false;
      }

      match /notifications/{notificationId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow create: if isWorkspaceScopedManagerWrite(workspaceId);
        allow update, delete: if false;
      }

      match /payStatements/{statementId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow create, update: if isWorkspaceScopedManagerWrite(workspaceId);
        allow delete: if false;
      }

      match /payrollWorkerMonthRows/{rowId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow update: if isWorkspaceScopedManagerWrite(workspaceId);
        allow create, delete: if false;
      }

      match /workRecords/{recordId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow update: if isWorkspaceManagerAfter(workspaceId)
          && isWorkRecordManagerAction();
        allow create, delete: if false;
      }

      match /anomalyFlags/{flagId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow update: if isWorkspaceManagerAfter(workspaceId)
          && isAnomalyFlagManagerResolution();
        allow create, delete: if false;
      }

      match /anomalyResolutions/{resolutionId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow create: if isWorkspaceManagerAfter(workspaceId)
          && isAnomalyResolutionCreate(workspaceId);
        allow update, delete: if false;
      }

      match /notificationSettings/{settingsId} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow create: if isWorkspaceManagerAfter(workspaceId)
          && settingsId == 'default'
          && isNotificationSettingsCreate(workspaceId);
        allow update: if isWorkspaceManagerAfter(workspaceId)
          && settingsId == 'default'
          && isNotificationSettingsEdit(workspaceId);
        allow delete: if false;
      }

      match /{document=**} {
        allow get, list: if isWorkspaceManager(workspaceId);
        allow create, update, delete: if false;
      }
    }

    match /workspaceCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.active == true
        && request.resource.data.workspaceId is string
        && isWorkspaceManagerAfter(request.resource.data.workspaceId);
      allow update, delete: if false;
    }
  }
}
